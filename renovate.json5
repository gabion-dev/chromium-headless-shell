// a Dependency Dashboard issue, vulnerability fixes without delay, GitHub
// Actions pinned by digest. Only what is particular to this repository is
// written here.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>gabion-dev/renovate-config"],
}
